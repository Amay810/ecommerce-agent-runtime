# Local model backend
ARAG_AGENT_BACKEND=local
ARAG_LOCAL_MODEL=Qwen/Qwen3-4B-Instruct-2507
ARAG_LOCAL_MAX_NEW_TOKENS=512

# OpenAI-compatible backend (never commit a real key)
# The native experiment uses Qwen behind an OpenAI-compatible wire protocol;
# the endpoint is intentionally explicit so an unset environment cannot select
# a hosted OpenAI model by accident.
# ARAG_LLM_BASE_URL=http://127.0.0.1:8123/v1
# ARAG_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
# ARAG_LLM_API_KEY=local-vllm

# Optional retrieval configuration
ERAG_PRODUCTS=ecommerce_rag/data/sample_products.jsonl
ERAG_POLICIES=ecommerce_rag/data/policies.jsonl
ERAG_TOP_K=5
ERAG_USE_RERANKER=0

# External Retail evaluation provider settings, if used
# TAU3_AGENT_BASE_URL=http://127.0.0.1:8000/v1
# TAU3_AGENT_API_KEY=replace-me
# TAU3_AGENT_MODEL=Qwen/Qwen3-4B-Instruct-2507
# TAU3_USER_API_KEY=replace-me
